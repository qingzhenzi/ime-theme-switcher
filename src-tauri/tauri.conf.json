{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ime-theme-switcher",
  "version": "0.3.1",
  "identifier": "dev.qingzhenzi.ime-theme-switcher",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "输入法候选框样式",
        "width": 1040,
        "height": 720,
        "minWidth": 720,
        "minHeight": 460,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
